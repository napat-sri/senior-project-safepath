# =============================================================================
# SafePath Berlin — environment variables
#
# Copy this file to `.env` and fill in the values for your machine:
#   cp .env.example .env
#
# Vue CLI exposes only variables prefixed with VUE_APP_ to client code.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vue) — read by src/App.vue at build/serve time
# -----------------------------------------------------------------------------

# URL template for the OpenStreetMap tile server.
# Local self-hosted tile server (requires `osm-import` to have run):
VUE_APP_TILE_URL=http://localhost:8081/tile/{z}/{x}/{y}.png
# Or use the public OSM tile server for development without the import step:
# VUE_APP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Langflow host (used by the embedded chat widget in the browser).
VUE_APP_LANGFLOW_HOST=http://localhost:7860

# Flow ID of the SafePath agent in Langflow.
# Matches the `id` field in langflow/flows/SafePathChat.json, which Langflow
# auto-imports on first boot. If you re-export the flow under a different ID,
# update this value to match.
VUE_APP_LANGFLOW_FLOW_ID=dd195420-870e-4896-8b6c-794902b319b1

# Langflow API key (created in the Langflow UI under Settings > API Keys).
# NOTE: This value ends up in the browser bundle. Use a key scoped to the
# SafePath flow only; do not reuse a privileged key.
VUE_APP_LANGFLOW_API_KEY=Your_Langflow_API_Key_Here
# -----------------------------------------------------------------------------
# Backend / data sources (used by future backend service, not the frontend)
# -----------------------------------------------------------------------------
BERLIN_CRIME_API_URL=https://www.statistik-berlin-brandenburg.de/opendata
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
GOOGLE_API_KEY=Your-Google-API-Key-Here

# Keycloak login configuration
VUE_APP_KEYCLOAK_URL=http://localhost:8090
VUE_APP_KEYCLOAK_REALM=safepath
VUE_APP_KEYCLOAK_CLIENT_ID=safepath-frontend
VUE_APP_API_URL=http://localhost:9000/api