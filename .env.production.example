# -----------------------------------------------------------------------------
# Frontend (Vue) — read by src/App.vue at build/serve time
# -----------------------------------------------------------------------------

VUE_APP_API_URL=/api

VUE_APP_TILE_URL=https://safepath.duckdns.org/tile/{z}/{x}/{y}.png
VUE_APP_LANGFLOW_HOST=https://safepath.duckdns.org/langflow

VUE_APP_LANGFLOW_CHATBOT_FLOW_ID=Your_VUE_APP_LANGFLOW_CHATBOT_FLOW_ID
VUE_APP_LANGFLOW_ROUTE_AGENT_FLOW_ID=Your_VUE_APP_LANGFLOW_ROUTE_AGENT_FLOW_ID

# Langflow API key (created in the Langflow UI under Settings > API Keys).
# NOTE: This value ends up in the browser bundle. Use a key scoped to the
# SafePath flow only; do not reuse a privileged key.
VUE_APP_LANGFLOW_API_KEY=Your_VUE_APP_LANGFLOW_API_KEY
# -----------------------------------------------------------------------------
# Backend / data sources (used by future backend service, not the frontend)
# -----------------------------------------------------------------------------
BERLIN_CRIME_API_URL=https://www.statistik-berlin-brandenburg.de/opendata
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
VUE_APP_LANGFLOW_CHAT_POSITION=bottom-right

# Langflow API key
LANGFLOW_AUTO_LOGIN=False
LANGFLOW_SUPERUSER=Your_LANGFLOW_SUPERUSER
LANGFLOW_SUPERUSER_PASSWORD=Your_LANGFLOW_SUPERUSER_PASSWORD
LANGFLOW_SECRET_KEY=Your_LANGFLOW_SECRET_KEY
LANGFLOW_NEW_USER_IS_ACTIVE=False
LANGFLOW_ENABLE_SUPERUSER_CLI=False


# DB configuration
POSTGRES_USER=Your_POSTGRES_USER
POSTGRES_PASSWORD=Your_POSTGRES_PASSWORD
POSTGRES_DB=langflow
POSTGRES_PORT=5432

# ==== Langfuse stack environment ====
# Copy to .env and fill in. In Portainer, paste these into the Stack's
# environment variables section instead of committing real secrets.

# ---- Public URL (must be your real HTTPS domain served by Caddy) ----
NEXTAUTH_URL=https://langfuse.safepath.duckdns.org

# ---- Core secrets (CHANGE ALL OF THESE) ----
# Generate with: openssl rand -hex 32   (ENCRYPTION_KEY must be exactly 64 hex chars)
ENCRYPTION_KEY=Your_ENCRYPTION_KEY
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=Your_NEXTAUTH_SECRET
SALT=Your_SALT

# ---- Postgres ----
POSTGRES_USER=Your_POSTGRES_USER
POSTGRES_PASSWORD=Your_POSTGRES_PASSWORD
POSTGRES_DB=postgres
POSTGRES_VERSION=17

# ---- ClickHouse ----
CLICKHOUSE_USER=Your_CLICKHOUSE_USER
CLICKHOUSE_PASSWORD=Your_CLICKHOUSE_PASSWORD
CLICKHOUSE_CLUSTER_ENABLED=false

# ---- Redis ----
REDIS_AUTH=Your_REDIS_AUTH

# ---- MinIO (S3) ----
MINIO_ROOT_USER=Your_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=Your_MINIO_ROOT_PASSWORD
# Only set to a public URL if you need media (images/audio) to render in the browser:
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=https://minio.yourname.duckdns.org

# ---- Keycloak SSO ----
AUTH_KEYCLOAK_CLIENT_ID=Your_AUTH_KEYCLOAK_CLIENT_ID
AUTH_KEYCLOAK_CLIENT_SECRET=Your_AUTH_KEYCLOAK_CLIENT_SECRET
# Format: https://<keycloak-domain>/realms/<realm-name>
AUTH_KEYCLOAK_ISSUER=https://login.safepath.duckdns.org/realms/master/.well-known/openid-configuration
AUTH_KEYCLOAK_ALLOW_ACCOUNT_LINKING=true
# Set true to force everyone through Keycloak and hide email/password login:
AUTH_DISABLE_USERNAME_PASSWORD=false

# ---- Misc ----
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

LANGFUSE_SECRET_KEY="Your_LANGFUSE_SECRET_KEY"
LANGFUSE_PUBLIC_KEY="Your_LANGFUSE_PUBLIC_KEY"
LANGFUSE_BASE_URL="https://langfuse.safepath.duckdns.org"
LANGFLOW_LOG_LEVEL=DEBUG


LITELLM_VIRTUAL_KEY = Your_LITELLM_VIRTUAL_KEY
LITELLM_PROXY_URL = Your_LITELLM_PROXY_URL
LOCATIONIQ_API_KEY=Your_LOCATIONIQ_API_KEY