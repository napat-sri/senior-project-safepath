# -----------------------------------------------------------------------------
# Frontend (Vue) — read by src/App.vue at build/serve time
# -----------------------------------------------------------------------------


VUE_APP_API_URL=http://localhost:9000/api
VUE_APP_TILE_URL=http://localhost:8081/tile/{z}/{x}/{y}.png
VUE_APP_LANGFLOW_HOST=http://localhost:7860
VUE_APP_LANGFLOW_CHATBOT_FLOW_ID=Your_VUE_APP_LANGFLOW_CHATBOT_FLOW_ID
VUE_APP_LANGFLOW_ROUTE_AGENT_FLOW_ID=Your_VUE_APP_LANGFLOW_ROUTE_AGENT_FLOW_ID

# Langflow API key (created in the Langflow UI under Settings > API Keys).
VUE_APP_LANGFLOW_API_KEY=Your_VUE_APP_LANGFLOW_API_KEY
# -----------------------------------------------------------------------------
# Backend / data sources (used by future backend service, not the frontend)
# -----------------------------------------------------------------------------
BERLIN_CRIME_API_URL=https://www.statistik-berlin-brandenburg.de/opendata
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
VUE_APP_LANGFLOW_CHAT_POSITION=bottom-right

# Keycloak login configuration
## frontend
VUE_APP_KEYCLOAK_URL=http://localhost:8090
VUE_APP_KEYCLOAK_REALM=safepath
VUE_APP_KEYCLOAK_CLIENT_ID=safepath-frontend
VUE_APP_API_URL=http://localhost:9000/api

## backend
KEYCLOAK_ISSUER=http://localhost:8090/realms/safepath        # prod: https://login.safepath.duckdns.org/realms/safepath
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/safepath/protocol/openid-connect/certs   # prod: same host as issuer + /certs
KEYCLOAK_AUDIENCE=safepath-api

## user management
KEYCLOAK_BASE_URL=http://keycloak:8080        # internal docker hostname, matches KEYCLOAK_JWKS_URL's host
KEYCLOAK_REALM=safepath
KEYCLOAK_ADMIN_CLIENT_ID=safepath-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=Your_KEYCLOAK_ADMIN_CLIENT_SECRET


LITELLM_VIRTUAL_KEY = Your_LITELLM_VIRTUAL_KEY
LITELLM_PROXY_URL = Your_LITELLM_PROXY_URL
LOCATIONIQ_API_KEY=Your_LOCATIONIQ_API_KEY

## Langfuse stack environment (Production data, but can be used for local dev)
LANGFUSE_SECRET_KEY="Your_LANGFUSE_SECRET_KEY"
LANGFUSE_PUBLIC_KEY="Your_LANGFUSE_PUBLIC_KEY"
LANGFUSE_BASE_URL="https://langfuse.safepath.duckdns.org"
LANGFLOW_LOG_LEVEL=DEBUG


MCP_SSE_URL = http://mcp:8000/sse